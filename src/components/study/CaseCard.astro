---
/**
 * Callout for a real-world case (Glencore, McDonald's, Apple…).
 * Usage: <CaseCard title="McDonald's Luxembourg" year="2015-2018" outcome="No illegal aid found">body…</CaseCard>
 */
interface Props {
  title: string;
  year?: string;
  outcome?: string;
}
const { title, year, outcome } = Astro.props;
---

<aside class="not-prose my-6 rounded-lg border border-hairline bg-surface-soft p-5 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="t-eyebrow text-primary">Real case</span>
      {year && <span class="t-caption">{year}</span>}
    </div>
    {
      outcome && (
        <span class="inline-flex items-center rounded-full bg-canvas px-3 py-1 text-xs font-semibold text-ink ring-1 ring-hairline">
          {outcome}
        </span>
      )
    }
  </div>
  <h3 class="mt-2 text-lg font-semibold tracking-tight text-ink">{title}</h3>
  <div class="mt-2 space-y-3 text-[0.95rem] leading-relaxed text-mute">
    <slot />
  </div>
</aside>
