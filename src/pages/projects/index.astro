---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PostCard from '../../components/PostCard.astro';

const projects = (await getCollection('projects'))
  .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Projects"
  description="Real work and case studies I take on as I learn - uploaded as I finish them."
>
  <Container class="py-16 sm:py-20">
    <div class="max-w-2xl">
      <Eyebrow>Projects</Eyebrow>
      <h1 class="mt-3 t-display-lg">Things I’m building.</h1>
      <p class="mt-5 t-body-lg">
        Real work and case studies I take on as I learn - added here as I finish them.
      </p>
    </div>

    {
      projects.length > 0 ? (
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <PostCard
              href={`/projects/${p.id}`}
              eyebrow="Project"
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              tags={p.data.tags}
              badge={p.data.status === 'in-progress' ? 'In progress' : undefined}
            />
          ))}
        </div>
      ) : (
        <div class="mt-12 rounded-lg border border-dashed border-hairline bg-surface-soft p-10 text-center">
          <p class="t-heading-sm text-ink">First project coming soon.</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-mute">
            I’m working on the first one now - it’ll appear here when it’s ready.
          </p>
        </div>
      )
    }
  </Container>
</BaseLayout>
