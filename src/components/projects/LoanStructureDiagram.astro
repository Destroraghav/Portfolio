---
/**
 * Exhibit: the controlled transaction. A Luxembourg intra-group financing
 * company lends to an Indian manufacturing subsidiary; interest flows back.
 * Both wholly owned by the same parent. Token-driven, light system.
 */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="not-prose my-8 overflow-x-auto rounded-lg border border-hairline bg-surface-soft p-4 sm:p-6">
  <svg viewBox="0 0 720 300" class="mx-auto block h-auto w-full min-w-[640px] max-w-[680px]" role="img" aria-label="Meridian Lux Finance (Luxembourg) lends EUR 50 million to Forgeline Industries (India); interest flows back at 2.831 percent. Both are wholly owned by the same parent.">
    <!-- parent -->
    <rect x="270" y="16" width="180" height="58" rx="12" fill="var(--color-canvas)" stroke="var(--color-hairline)"></rect>
    <text x="360" y="40" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="var(--color-ink)">Ultimate Parent</text>
    <text x="360" y="58" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-mute)">Group holding company</text>

    <!-- ownership lines -->
    <path d="M360 74 V104 M150 104 H570 M150 104 V150 M570 104 V150" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1" stroke-dasharray="3 4"></path>
    <text x="360" y="99" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="var(--color-stone)">100% owned</text>

    <!-- lender -->
    <rect x="34" y="150" width="232" height="96" rx="14" fill="var(--color-canvas)" stroke="var(--color-primary)" stroke-width="2"></rect>
    <text x="150" y="178" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="var(--color-ink)">Meridian Lux Finance</text>
    <text x="150" y="196" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="var(--color-primary)">Luxembourg · lender</text>
    <text x="150" y="214" text-anchor="middle" font-family="Inter, sans-serif" font-size="10.5" fill="var(--color-mute)">Intra-group financing co.</text>
    <text x="150" y="230" text-anchor="middle" font-family="Inter, sans-serif" font-size="10.5" fill="var(--color-mute)">Bears &amp; controls credit risk</text>

    <!-- borrower -->
    <rect x="454" y="150" width="232" height="96" rx="14" fill="var(--color-canvas)" stroke="var(--color-hairline)"></rect>
    <text x="570" y="178" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="var(--color-ink)">Forgeline Industries</text>
    <text x="570" y="196" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="var(--color-ink)">India · borrower</text>
    <text x="570" y="214" text-anchor="middle" font-family="Inter, sans-serif" font-size="10.5" fill="var(--color-mute)">Forgings / EV components</text>
    <text x="570" y="230" text-anchor="middle" font-family="Inter, sans-serif" font-size="10.5" fill="var(--color-mute)">Tested party</text>

    <!-- loan flow -->
    <path d="M266 182 H452" fill="none" stroke="var(--color-primary)" stroke-width="2" marker-end="url(#ls-arrow)"></path>
    <text x="360" y="176" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="var(--color-primary)">EUR 50,000,000 term loan</text>

    <!-- interest flow -->
    <path d="M452 214 H268" fill="none" stroke="var(--color-stone)" stroke-width="1.6" marker-end="url(#ls-arrow-g)"></path>
    <text x="360" y="232" text-anchor="middle" font-family="Inter, sans-serif" font-size="10.5" fill="var(--color-body)">Interest at 2.831% (arm's length)</text>

    <!-- terms -->
    <text x="360" y="276" text-anchor="middle" font-family="Inter, sans-serif" font-size="10.5" fill="var(--color-stone)">3-year tenor · senior unsecured · bullet repayment · no guarantee · EUR</text>

    <defs>
      <marker id="ls-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0 0 L7 4 L0 8 z" fill="var(--color-primary)"></path>
      </marker>
      <marker id="ls-arrow-g" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0 0 L7 4 L0 8 z" fill="var(--color-stone)"></path>
      </marker>
    </defs>
  </svg>
  {caption && <figcaption class="mt-3 text-center text-sm text-mute">{caption}</figcaption>}
</figure>
