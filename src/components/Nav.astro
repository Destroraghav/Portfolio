---
import Container from './Container.astro';
import Button from './Button.astro';
import { SITE, NAV_LINKS, fullName } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/85 backdrop-blur-md">
  <Container>
    <nav class="flex h-16 items-center justify-between gap-4" aria-label="Primary">
      <!-- Wordmark (cobalt brand mark = the one sanctioned scarce use) -->
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${fullName} — home`}>
        <span
          class="grid h-7 w-7 place-items-center rounded-md bg-primary text-on-primary text-sm font-semibold leading-none"
          aria-hidden="true">J</span
        >
        <span class="text-base font-medium tracking-tight text-ink">{SITE.wordmark}</span>
      </a>

      <!-- Center links (desktop) -->
      <ul class="hidden md:flex items-center gap-1">
        {
          NAV_LINKS.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'rounded-full px-3.5 py-2 text-[0.95rem] transition-colors',
                  isActive(l.href) ? 'text-ink font-medium' : 'text-mute hover:text-ink',
                ]}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Right CTA (desktop) -->
      <div class="hidden md:flex items-center gap-2 shrink-0">
        <Button href="/contact" variant="dark" size="md">Get in touch</Button>
      </div>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="md:hidden grid h-10 w-10 place-items-center rounded-full border border-hairline text-ink"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>
  </Container>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-hairline bg-canvas">
    <Container class="py-4">
      <ul class="flex flex-col gap-1">
        {
          NAV_LINKS.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'block rounded-xl px-3 py-2.5 text-base',
                  isActive(l.href) ? 'text-ink bg-surface-soft font-medium' : 'text-mute',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-3">
        <Button href="/contact" variant="dark" size="lg" class="w-full">Get in touch</Button>
      </div>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
