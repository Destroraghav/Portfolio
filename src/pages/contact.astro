---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { SITE, fullName } from '../consts';

const channels = [
  {
    label: 'Email',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    desc: 'The best way to reach me directly.',
  },
  {
    label: 'LinkedIn',
    value: 'Connect & message',
    href: SITE.linkedin,
    desc: 'Where I post and connect about Luxembourg tax.',
    external: true,
  },
];
---

<BaseLayout title="Contact" description={`Get in touch with ${fullName}.`}>
  <Container class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <Eyebrow>Contact</Eyebrow>
      <h1 class="mt-3 t-display-lg">Let’s talk.</h1>
      <p class="mt-5 max-w-xl t-body-lg">
        Whether you’re hiring for a tax role in Luxembourg, want to collaborate, or just want to say
        hello - I’d love to hear from you.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          channels.map((c) => (
            <a
              href={c.href}
              rel={c.external ? 'noopener noreferrer' : undefined}
              target={c.external ? '_blank' : undefined}
              class="group flex flex-col rounded-lg border border-hairline bg-canvas p-6 transition-colors hover:bg-surface-soft"
            >
              <span class="t-caption">{c.label}</span>
              <span class="mt-1 text-lg font-semibold tracking-tight text-ink group-hover:text-primary">
                {c.value}
              </span>
              <span class="mt-2 text-sm text-mute">{c.desc}</span>
            </a>
          ))
        }
      </div>

      <div class="mt-4 flex flex-col gap-4 rounded-lg border border-hairline bg-surface-soft p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-base font-medium text-ink">Prefer the short version?</p>
          <p class="mt-1 text-sm text-mute">Download my CV.</p>
        </div>
        <Button href={SITE.cvPath} variant="dark" size="lg" download>Download CV</Button>
      </div>

      <p class="mt-8 t-caption">Based in {SITE.location}. Open to relocating to Luxembourg.</p>
    </div>
  </Container>
</BaseLayout>
