---
/**
 * The recurring case company, Meridian Group, as an org diagram.
 * `highlight` emphasises the entities a given lesson is about.
 * Usage: <MeridianDiagram highlight={["pl","fr"]} caption="This lesson prices the Poland -> France leg." />
 */
interface Props {
  highlight?: Array<'de' | 'pl' | 'fr' | 'lu'>;
  caption?: string;
}
const { highlight = [], caption } = Astro.props;
const on = (k: string) => highlight.length === 0 || highlight.includes(k as any);

const subs = [
  { k: 'pl', x: 24, name: 'Meridian Manufacturing', country: 'Poland', role: 'Assembles the products' },
  { k: 'fr', x: 255, name: 'Meridian France', country: 'France', role: 'Distribution & sales' },
  { k: 'lu', x: 486, name: 'Meridian Finance', country: 'Luxembourg', role: 'Group treasury & financing' },
];
---

<figure class="not-prose my-6 overflow-x-auto rounded-lg border border-hairline bg-surface-soft p-4 sm:p-6">
  <svg viewBox="0 0 720 360" class="mx-auto block h-auto w-full max-w-[680px]" role="img" aria-label="Meridian Group structure">
    <!-- ownership lines -->
    {subs.map((s) => (
      <line x1="360" y1="100" x2={s.x + 105} y2="250" stroke="var(--color-hairline-strong)" stroke-width="1" opacity={on('de') && on(s.k) ? '0.55' : '0.18'} />
    ))}

    <!-- parent -->
    <g opacity={on('de') ? '1' : '0.4'}>
      <rect x="260" y="26" width="200" height="74" rx="12" fill="var(--color-canvas)" stroke={on('de') ? 'var(--color-primary)' : 'var(--color-hairline)'} stroke-width={on('de') ? '2' : '1'} />
      <text x="360" y="52" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="var(--color-ink)">Meridian AG</text>
      <text x="360" y="70" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="var(--color-primary)">Germany · parent</text>
      <text x="360" y="86" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-mute)">Owns brand & IP · strategy</text>
    </g>

    <!-- subsidiaries -->
    {subs.map((s) => (
      <g opacity={on(s.k) ? '1' : '0.4'}>
        <rect x={s.x} y="250" width="210" height="86" rx="12" fill="var(--color-canvas)" stroke={on(s.k) ? 'var(--color-primary)' : 'var(--color-hairline)'} stroke-width={on(s.k) ? '2' : '1'} />
        <text x={s.x + 105} y="278" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="var(--color-ink)">{s.name}</text>
        <text x={s.x + 105} y="296" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="var(--color-primary)">{s.country}</text>
        <text x={s.x + 105} y="314" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="var(--color-mute)">{s.role}</text>
      </g>
    ))}
  </svg>
  {caption && <figcaption class="mt-3 text-center text-sm text-mute">{caption}</figcaption>}
</figure>
