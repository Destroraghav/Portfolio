---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Tag from '../../components/Tag.astro';

const courses = (await getCollection('courses'))
  .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
  .sort((a, b) => a.data.order - b.data.order);

const allModules = await getCollection('modules');
const moduleCount = (courseId: string) =>
  allModules.filter((m) => m.data.course === courseId && (import.meta.env.PROD ? !m.data.draft : true)).length;
---

<BaseLayout
  title="Study Material"
  description="Chapter-by-chapter courses - Enrolled Agent, corporate finance, transfer pricing - you can learn from and prepare with."
>
  <Container class="py-16 sm:py-20">
    <div class="max-w-2xl">
      <Eyebrow>Study Material</Eyebrow>
      <h1 class="mt-3 t-display-lg">Learn alongside me.</h1>
      <p class="mt-5 t-body-lg">
        As I prepare for exams and courses, I turn my notes into structured, chapter-by-chapter
        material - so you can follow along and prepare too.
      </p>
    </div>

    {
      courses.length > 0 ? (
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {courses.map((c) => (
            <a
              href={`/study/${c.id}`}
              class="group flex h-full flex-col rounded-lg border border-hairline bg-canvas p-8 transition-colors hover:bg-surface-soft"
            >
              <div class="flex items-center gap-2.5">
                {c.data.exam && <Tag variant="feature">{c.data.exam}</Tag>}
                <span class="t-caption">{moduleCount(c.id)} modules</span>
              </div>
              <h2 class="mt-3 t-heading-md group-hover:text-primary">{c.data.title}</h2>
              <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-mute">{c.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink">
                Start the course
                <span class="transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-12 rounded-lg border border-dashed border-hairline bg-surface-soft p-10 text-center">
          <p class="t-heading-sm text-ink">First course coming soon.</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-mute">
            I’m turning my Enrolled Agent and corporate-finance prep into a course right now.
          </p>
        </div>
      )
    }
  </Container>
</BaseLayout>
