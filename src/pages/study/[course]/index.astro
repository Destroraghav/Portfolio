---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import Button from '../../../components/Button.astro';
import ModuleCard from '../../../components/study/ModuleCard.astro';
import MeridianDiagram from '../../../components/study/MeridianDiagram.astro';
import PriceConceptArt from '../../../components/study/PriceConceptArt.astro';
import ShareRow from '../../../components/study/ShareRow.astro';
import { moduleHeroImage } from '../../../lib/studyHero';
import { SITE } from '../../../consts';

export const getStaticPaths = (async () => {
  const courses = await getCollection('courses');
  const modules = await getCollection('modules');
  const lessons = await getCollection('lessons');
  return courses
    .filter((c) => (import.meta.env.PROD ? !c.data.draft : true))
    .map((course) => {
      const courseModules = modules
        .filter((m) => m.data.course === course.id && (import.meta.env.PROD ? !m.data.draft : true))
        .sort((a, b) => a.data.order - b.data.order);
      const lessonCount = (moduleSlug: string) =>
        lessons.filter(
          (l) =>
            l.data.course === course.id &&
            l.data.module === moduleSlug &&
            (import.meta.env.PROD ? !l.data.draft : true)
        ).length;
      return { params: { course: course.id }, props: { course, courseModules, lessonCount } };
    });
}) satisfies GetStaticPaths;

const { course, courseModules, lessonCount } = Astro.props;
const d = course.data;

const firstModule = courseModules.find((m) => m.data.status === 'published') ?? courseModules[0];
const startHref = firstModule ? `/study/${course.id}/${firstModule.data.slug}` : `/study/${course.id}`;
const totalLessons = courseModules.reduce((sum, m) => sum + lessonCount(m.data.slug), 0);

// A dedicated share card exists only for transfer-pricing; other courses fall
// back to the site default banner. (Regenerate the PNG with `npm run og`.)
const ogImage = course.id === 'transfer-pricing' ? '/og-transfer-pricing.png' : undefined;
const shareUrl = `${SITE.url}/study/${course.id}/`;
const shareText = 'A free, plain-English transfer pricing course, from zero';

const personas = [
  {
    icon: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M21 8v6M7 11v5c0 1 2 3 5 3s5-2 5-3v-5"/>',
    title: 'You want a tax career',
    body: 'A student or early professional aiming for a role in international or corporate tax, and you want a real, job-relevant skill.',
  },
  {
    icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 115 .5c0 1.5-2.5 2-2.5 3.5"/><path d="M12 17h.01"/>',
    title: 'You keep hearing the term',
    body: 'You have seen “transfer pricing” in the news or at work and want to actually understand what it means and why it matters.',
  },
  {
    icon: '<path d="M4 4h16v13H5.5L4 19V4z"/><path d="M8 9h8M8 12h5"/>',
    title: 'You have an interview soon',
    body: 'You need to speak confidently about methods, benchmarking, and the arm’s length principle, fast, and with worked examples.',
  },
];

const skills = [
  {
    icon: '<rect x="9" y="3" width="6" height="6" rx="1"/><rect x="3" y="15" width="6" height="6" rx="1"/><rect x="15" y="15" width="6" height="6" rx="1"/><path d="M12 9v3M12 12H6v3M12 12h6v3"/>',
    title: "Read a group's structure",
    body: 'Spot when two companies count as related, and work out who really earns the profit.',
  },
  {
    icon: '<path d="M4 7h16M4 12h16M4 17h10"/><circle cx="18" cy="17" r="2.5"/>',
    title: 'Pick the right method',
    body: 'Know which of the five pricing methods fits a deal, and how to actually apply it.',
  },
  {
    icon: '<path d="M4 19V5"/><path d="M4 15l5-4 4 3 7-7"/>',
    title: 'Build a defensible range',
    body: "Choose a benchmark, and decide whether a company's profit is in line or off.",
  },
  {
    icon: '<path d="M12 3l2.5 5 5.5.8-4 4 1 5.4L12 21l-5 2.6 1-5.4-4-4 5.5-.8L12 3z"/>',
    title: 'Price the hard things',
    body: 'Brands and patents, intra-group loans and guarantees, and business reorganisations.',
  },
  {
    icon: '<path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/>',
    title: 'Work a full case',
    body: 'Two complete clinics take you from a blank page to a defensible conclusion.',
  },
  {
    icon: '<path d="M5 21V4M5 4c3-1.5 6 1.5 9 0v8c-3 1.5-6-1.5-9 0"/>',
    title: 'Speak Luxembourg',
    body: 'The local rules and the financing benchmark that a Luxembourg tax role runs on.',
    featured: true,
  },
];

const steps = [
  {
    art: '<svg viewBox="0 0 80 60" width="96" height="72" aria-hidden="true"><rect x="14" y="8" width="52" height="44" rx="6" fill="var(--color-canvas)" stroke="var(--color-hairline)"/><path d="M24 20h32M24 28h32M24 36h22" stroke="var(--color-hairline-strong)" stroke-width="2.4" stroke-linecap="round"/></svg>',
    title: 'Read the idea',
    body: 'Every term is defined the first time it appears. Plain English, short lessons.',
  },
  {
    art: '<svg viewBox="0 0 80 60" width="96" height="72" aria-hidden="true"><rect x="18" y="8" width="44" height="44" rx="6" fill="var(--color-canvas)" stroke="var(--color-hairline)"/><rect x="26" y="16" width="28" height="9" rx="2" fill="var(--color-surface-soft)"/><circle cx="31" cy="34" r="3" fill="var(--color-hairline-strong)"/><circle cx="40" cy="34" r="3" fill="var(--color-hairline-strong)"/><circle cx="49" cy="34" r="3" fill="var(--color-primary)"/><circle cx="31" cy="43" r="3" fill="var(--color-hairline-strong)"/><circle cx="40" cy="43" r="3" fill="var(--color-hairline-strong)"/><circle cx="49" cy="43" r="3" fill="var(--color-hairline-strong)"/></svg>',
    title: 'See it worked out',
    body: 'A step by step example with real numbers you can follow, using the same case company.',
  },
  {
    art: '<svg viewBox="0 0 80 60" width="96" height="72" aria-hidden="true"><rect x="14" y="8" width="52" height="44" rx="6" fill="var(--color-canvas)" stroke="var(--color-hairline)"/><circle cx="40" cy="30" r="13" fill="var(--color-surface-soft)"/><path d="M34 30l4 4 8-8" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    title: 'Test yourself',
    body: 'A short quiz at the end of each module, with the reasoning explained, so it sticks.',
  },
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={ogImage}
  imageAlt={ogImage ? 'Transfer Pricing — a free, self-paced course. 11 modules, from zero.' : undefined}
>
  <!-- HERO -->
  <Container class="py-16 sm:py-20">
    <a href="/study" class="inline-flex items-center gap-1.5 text-sm text-mute hover:text-ink">
      <span aria-hidden="true">←</span> All courses
    </a>
    <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1.08fr_0.92fr]">
      <div>
        <Eyebrow>Free, self-paced course</Eyebrow>
        <h1 class="mt-4 t-display-lg">
          The tax skill behind every global company, taught from zero.
        </h1>
        <p class="mt-5 max-w-[34em] t-body-lg">
          When companies in the same group sell to each other across borders, someone has to set
          the price. That decision moves billions in profit and tax between countries. This course
          teaches you how it works, in plain English, with no prior tax knowledge assumed.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href={startHref} variant="dark" size="lg">Start learning, free →</Button>
          <Button href="#curriculum" variant="outline">See the {courseModules.length} modules</Button>
        </div>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5 text-sm text-mute">
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[17px] w-[17px] text-primary"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18"></path></svg>
            {courseModules.length} modules, {totalLessons} lessons
          </span>
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[17px] w-[17px] text-primary"><circle cx="12" cy="12" r="9"></circle><path d="M9 12l2 2 4-4"></path></svg>
            No sign-up needed
          </span>
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[17px] w-[17px] text-primary"><path d="M12 3v18M3 12h18"></path></svg>
            Sourced from OECD & EU
          </span>
        </div>
      </div>
      <PriceConceptArt />
    </div>
  </Container>

  <!-- TRUST STRIP -->
  <div class="border-y border-hairline bg-surface-soft">
    <Container class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-5">
      <span class="text-sm font-semibold text-ink">One recurring case company</span>
      <span class="text-sm font-semibold text-ink">Real landmark cases</span>
      <span class="text-sm font-semibold text-ink">Worked numbers you can follow</span>
      <span class="text-sm font-semibold text-ink">A Luxembourg deep-dive</span>
    </Container>
  </div>

  <!-- WHO THIS IS FOR -->
  <Container class="py-16 sm:py-20">
    <Eyebrow>Who this is for</Eyebrow>
    <h2 class="mt-4 max-w-[16em] t-display-md">If any of these sound like you, you’re in the right place.</h2>
    <div class="mt-9 grid gap-4 sm:grid-cols-3">
      {
        personas.map((p) => (
          <div class="rounded-lg border border-hairline bg-canvas p-6">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-primary/8 text-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[22px] w-[22px]" set:html={p.icon} />
            </div>
            <h3 class="mt-4 t-heading-sm">{p.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-mute">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Container>

  <!-- WHAT YOU'LL BE ABLE TO DO -->
  <Container class="pb-4">
    <Eyebrow>What you’ll be able to do</Eyebrow>
    <h2 class="mt-4 max-w-[15em] t-display-md">Skills you can put on a CV, not just definitions.</h2>
    <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((s) => (
          <div
            class:list={[
              'rounded-lg border p-6',
              s.featured ? 'border-primary bg-primary/8' : 'border-hairline bg-canvas',
            ]}
          >
            {s.featured && (
              <div class="mb-3 inline-flex rounded-full bg-canvas px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-primary">
                Job-specific
              </div>
            )}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-[26px] w-[26px] text-primary" set:html={s.icon} />
            <h3 class="mt-3.5 t-heading-sm">{s.title}</h3>
            <p class:list={['mt-2 text-[0.95rem] leading-relaxed', s.featured ? 'text-body' : 'text-mute']}>
              {s.body}
            </p>
          </div>
        ))
      }
    </div>
  </Container>

  <!-- HOW IT WORKS -->
  <div class="mt-16 border-y border-hairline bg-surface-soft">
    <Container class="py-16 sm:py-20">
      <Eyebrow>How every lesson works</Eyebrow>
      <h2 class="mt-4 t-display-md">Learn it, watch it worked, then prove it.</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          steps.map((s) => (
            <div class="rounded-lg border border-hairline bg-canvas p-7 text-center">
              <div class="flex justify-center" set:html={s.art} />
              <h3 class="mt-4 t-heading-sm">{s.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-mute">{s.body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </div>

  <!-- MEET MERIDIAN -->
  <Container class="py-16 sm:py-20">
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <Eyebrow>One company, cover to cover</Eyebrow>
        <h2 class="mt-4 t-display-md">Meet Meridian Group.</h2>
        <p class="mt-4 t-body-lg">
          Every worked example follows one fictional multinational, so each new idea lands on a
          company you already know. A German parent, a Polish factory, a French distributor, and a
          Luxembourg finance arm. The same cast, growing more real with every module.
        </p>
      </div>
      <MeridianDiagram />
    </div>
  </Container>

  <!-- CURRICULUM -->
  <Container id="curriculum" class="pb-16 sm:pb-20">
    <Eyebrow>The full curriculum</Eyebrow>
    <h2 class="mt-4 t-display-md">{courseModules.length} modules, built to stack.</h2>
    <div class="mt-9 grid gap-4">
      {
        courseModules.map((m) => (
          <ModuleCard
            number={m.data.order}
            title={m.data.title}
            summary={m.data.summary}
            status={m.data.status}
            href={m.data.status === 'published' ? `/study/${course.id}/${m.data.slug}` : undefined}
            lessonCount={lessonCount(m.data.slug)}
            heroImage={moduleHeroImage(course.id, m.data.order, m.data.heroImage)}
          />
        ))
      }
    </div>
  </Container>

  <!-- SHARE -->
  <div class="border-y border-hairline bg-surface-soft">
    <Container class="py-8">
      <ShareRow url={shareUrl} text={shareText} />
    </Container>
  </div>

  <!-- CLOSING CTA -->
  <div class="bg-canvas-dark text-on-dark">
    <Container class="py-20 text-center sm:py-24">
      <p class="t-eyebrow text-primary-bright">Start with a question</p>
      <h2 class="mx-auto mt-4 max-w-[18em] t-display-md text-on-dark">
        How does one price become a $340 million problem?
      </h2>
      <p class="mx-auto mt-5 max-w-[32em] text-lg text-on-dark-mute">
        That is a real case in this course. By the end, you’ll understand exactly how it happened,
        and be able to judge a price like it yourself. Free, no sign-up, start anywhere.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={startHref} variant="white" size="lg">Start learning now →</Button>
      </div>
    </Container>
  </div>
</BaseLayout>
