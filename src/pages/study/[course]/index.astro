---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import ModuleCard from '../../../components/study/ModuleCard.astro';

export const getStaticPaths = (async () => {
  const courses = await getCollection('courses');
  const modules = await getCollection('modules');
  const lessons = await getCollection('lessons');
  return courses
    .filter((c) => (import.meta.env.PROD ? !c.data.draft : true))
    .map((course) => {
      const courseModules = modules
        .filter((m) => m.data.course === course.id && (import.meta.env.PROD ? !m.data.draft : true))
        .sort((a, b) => a.data.order - b.data.order);
      const lessonCount = (moduleSlug: string) =>
        lessons.filter(
          (l) =>
            l.data.course === course.id &&
            l.data.module === moduleSlug &&
            (import.meta.env.PROD ? !l.data.draft : true)
        ).length;
      return { params: { course: course.id }, props: { course, courseModules, lessonCount } };
    });
}) satisfies GetStaticPaths;

const { course, courseModules, lessonCount } = Astro.props;
const d = course.data;
const { Content } = await render(course);
const publishedCount = courseModules.filter((m) => m.data.status === 'published').length;
---

<BaseLayout title={d.title} description={d.description}>
  <Container class="py-14 sm:py-20">
    <a href="/study" class="inline-flex items-center gap-1.5 text-sm text-mute hover:text-ink">
      <span aria-hidden="true">←</span> All courses
    </a>

    <!-- Hero -->
    <div class="mt-6 max-w-3xl">
      {d.exam && <Eyebrow>{d.exam}</Eyebrow>}
      <h1 class="mt-3 t-display-lg">{d.title}</h1>
      <p class="mt-5 t-body-lg">{d.description}</p>
      {
        d.hook && (
          <p class="mt-6 rounded-lg border border-hairline border-l-4 border-l-primary bg-surface-soft p-5 text-[0.975rem] leading-relaxed text-body">
            {d.hook}
          </p>
        )
      }
    </div>

    <!-- Optional intro body from the course file -->
    <div class="prose mt-8">
      <Content />
    </div>

    <!-- Who this is for -->
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 rounded-lg bg-surface-soft px-6 py-5">
      <div>
        <p class="t-caption">Level</p>
        <p class="text-sm text-ink">Zero prior tax knowledge assumed</p>
      </div>
      <div>
        <p class="t-caption">Format</p>
        <p class="text-sm text-ink">{courseModules.length} modules · self-paced</p>
      </div>
      <div>
        <p class="t-caption">Live now</p>
        <p class="text-sm text-ink">{publishedCount} of {courseModules.length} modules</p>
      </div>
    </div>

    <!-- Module map -->
    <h2 class="mt-14 t-heading-lg">Course modules</h2>
    <div class="mt-6 grid gap-4">
      {
        courseModules.map((m) => (
          <ModuleCard
            number={m.data.order}
            title={m.data.title}
            summary={m.data.summary}
            status={m.data.status}
            href={m.data.status === 'published' ? `/study/${course.id}/${m.data.slug}` : undefined}
            lessonCount={lessonCount(m.data.slug)}
          />
        ))
      }
    </div>
  </Container>
</BaseLayout>
