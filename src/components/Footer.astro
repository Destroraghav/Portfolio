---
import Container from './Container.astro';
import { SITE, NAV_LINKS, fullName } from '../consts';

const year = new Date().getFullYear();

const columns = [
  { heading: 'Explore', links: NAV_LINKS },
  {
    heading: 'Elsewhere',
    links: [
      { label: 'LinkedIn', href: SITE.linkedin },
      { label: 'Email', href: `mailto:${SITE.email}` },
      { label: 'Download CV', href: SITE.cvPath },
      { label: 'RSS feed', href: '/rss.xml' },
    ],
  },
];
---

<footer class="bg-canvas-dark text-on-dark">
  <Container class="py-20">
    <div class="grid gap-12 md:grid-cols-[1.6fr_repeat(2,1fr)]">
      <!-- Brand block -->
      <div>
        <a href="/" class="flex items-center gap-2.5" aria-label={`${fullName} - home`}>
          <span
            class="grid h-7 w-7 place-items-center rounded-md bg-primary text-on-primary text-sm font-semibold leading-none"
            aria-hidden="true">J</span
          >
          <span class="text-base font-medium tracking-tight text-on-dark">{SITE.wordmark}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-on-dark-mute">{SITE.tagline}</p>
        <p class="mt-3 text-sm text-on-dark-mute">{SITE.location}</p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-stone">{col.heading}</h2>
            <ul class="mt-4 flex flex-col gap-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-on-dark-mute transition-colors hover:text-on-dark">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-16 flex flex-col gap-2 border-t border-[color:var(--color-hairline-dark)] pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-stone">© {year} {fullName}. All rights reserved.</p>
      <p class="text-sm text-stone">Tax fundamentals, projects &amp; study material.</p>
    </div>
  </Container>
</footer>
