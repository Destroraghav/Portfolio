---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Tag from '../../components/Tag.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const date = d.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={d.title} description={d.description} article>
  <Container class="py-12 sm:py-16">
    <a href="/projects" class="inline-flex items-center gap-1.5 text-sm text-mute hover:text-ink">
      <span aria-hidden="true">←</span> All projects
    </a>

    <article class="mx-auto mt-6 max-w-[72ch]">
      <div class="flex flex-wrap items-center gap-2.5">
        <Tag variant="default">Project</Tag>
        {d.status === 'in-progress' && <Tag variant="feature">In progress</Tag>}
        <time datetime={d.date.toISOString()} class="t-caption">{date}</time>
      </div>

      <h1 class="mt-5 t-display-md text-balance">{d.title}</h1>
      <p class="mt-4 t-body-lg">{d.description}</p>

      <hr class="mt-8 border-hairline" />

      <div class="prose mt-8">
        <Content />
      </div>

      {
        d.tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-1.5 border-t border-hairline pt-6">
            {d.tags.map((t) => <li><Tag variant="outline">{t}</Tag></li>)}
          </ul>
        )
      }
    </article>
  </Container>
</BaseLayout>
