---
/**
 * Visible FAQ list. FAQ *schema* (JSON-LD FAQPage) is emitted separately at the
 * page level from frontmatter `faq`, so this renders the human-readable version.
 * Use as <FAQSection faqs={frontmatter.faq} /> in a post body if desired.
 */
interface FAQ {
  question: string;
  answer: string;
}
interface Props {
  faqs: FAQ[];
  title?: string;
}
const { faqs, title = 'Frequently Asked Questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="not-prose my-10">
      <h2 class="t-heading-lg">{title}</h2>
      <div class="mt-6 divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-semibold text-ink marker:content-['']">
              {f.question}
              <span class="shrink-0 text-mute transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-[0.975rem] leading-relaxed text-mute" set:html={f.answer} />
          </details>
        ))}
      </div>
    </section>
  )
}
