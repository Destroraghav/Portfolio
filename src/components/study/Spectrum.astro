---
/**
 * A labelled spectrum bar with an optional marker showing where an entity sits.
 * Usage:
 *   <Spectrum
 *     left="Limited Risk Distributor" leftDesc="low functions/assets/risk · modest, stable margin"
 *     right="Full-Fledged Distributor" rightDesc="high functions/assets/risk · higher, variable margin"
 *     markerPercent={70} markerLabel="Meridian France" />
 */
interface Props {
  left: string;
  leftDesc?: string;
  right: string;
  rightDesc?: string;
  markerPercent?: number; // 0 (far left) to 100 (far right)
  markerLabel?: string;
}
const { left, leftDesc, right, rightDesc, markerPercent, markerLabel } = Astro.props;
const pct = markerPercent != null ? Math.min(100, Math.max(0, markerPercent)) : null;
---

<div class="not-prose my-6 rounded-lg border border-hairline bg-canvas p-5 sm:p-6">
  <div class="relative">
    <div class="h-2 rounded-full bg-gradient-to-r from-surface-soft via-primary/25 to-primary"></div>
    {
      pct != null && (
        <div class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2" style={`left:${pct}%`}>
          <span class="block h-4 w-4 rounded-full border-2 border-canvas bg-primary shadow-sm" />
        </div>
      )
    }
  </div>
  {
    pct != null && markerLabel && (
      <div class="relative mt-1 h-5">
        <span
          class="absolute -translate-x-1/2 whitespace-nowrap text-xs font-semibold text-primary"
          style={`left:${pct}%`}
        >
          {markerLabel}
        </span>
      </div>
    )
  }
  <div class="mt-3 flex justify-between gap-6 text-sm">
    <div class="max-w-[45%]">
      <p class="font-semibold text-ink">{left}</p>
      {leftDesc && <p class="mt-0.5 text-mute">{leftDesc}</p>}
    </div>
    <div class="max-w-[45%] text-right">
      <p class="font-semibold text-ink">{right}</p>
      {rightDesc && <p class="mt-0.5 text-mute">{rightDesc}</p>}
    </div>
  </div>
</div>
