---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<BaseLayout title="Page not found">
  <Container class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <Eyebrow>404</Eyebrow>
    <h1 class="mt-3 t-display-lg">This page isn’t here.</h1>
    <p class="mt-4 max-w-md t-body-lg">The link may be old, or the page may have moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/" variant="dark" size="lg">Home</Button>
      <Button href="/blog" variant="soft" size="lg">Read the blog</Button>
    </div>
  </Container>
</BaseLayout>
