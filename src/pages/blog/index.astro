---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blog"
  description="Plain-English notes on tax fundamentals — the concepts I'm learning, explained simply."
>
  <Container class="py-16 sm:py-20">
    <div class="max-w-2xl">
      <Eyebrow>Blog</Eyebrow>
      <h1 class="mt-3 t-display-lg">Tax, from the ground up.</h1>
      <p class="mt-5 t-body-lg">
        Plain-English notes on the fundamentals — the concepts I’m learning, written down and
        explained as simply as I can.
      </p>
    </div>

    {
      posts.length > 0 ? (
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <PostCard
              href={`/blog/${p.id}`}
              eyebrow={p.data.category ?? p.data.topic}
              title={p.data.title}
              description={p.data.description}
              date={p.data.pubDate}
              tags={p.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="mt-12 rounded-lg border border-dashed border-hairline bg-surface-soft p-10 text-center">
          <p class="t-heading-sm text-ink">First post coming soon.</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-mute">
            I’m drafting the first set of tax fundamentals now. Check back shortly.
          </p>
        </div>
      )
    }
  </Container>
</BaseLayout>
