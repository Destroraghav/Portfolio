---
import Tag from './Tag.astro';

interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  badge?: string; // e.g. "In progress"
  image?: string; // hero/thumbnail image path
  imageAlt?: string;
}
const { href, eyebrow, title, description, date, tags = [], badge, image, imageAlt } = Astro.props;
const dateStr = date
  ? date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })
  : undefined;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-hairline bg-canvas transition-colors hover:bg-surface-soft"
>
  {
    image && (
      <div class="aspect-[16/10] overflow-hidden border-b border-hairline bg-surface-soft">
        <img
          src={image}
          alt={imageAlt ?? title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-7">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        {eyebrow && <span class="t-eyebrow text-stone">{eyebrow}</span>}
        {dateStr && <time class="t-caption">{dateStr}</time>}
      </div>
      {badge && <Tag variant="feature">{badge}</Tag>}
    </div>

    <h3 class="mt-3 t-heading-sm group-hover:text-primary">{title}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-mute">{description}</p>

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.slice(0, 4).map((t) => (
            <li>
              <Tag variant="outline">{t}</Tag>
            </li>
          ))}
        </ul>
      )
    }

    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink" aria-hidden="true">
      Read
      <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </span>
  </div>
</a>
