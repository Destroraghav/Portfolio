---
import Tag from '../Tag.astro';

interface Props {
  number: number;
  title: string;
  summary: string;
  href?: string; // omitted for coming-soon modules
  lessonCount?: number;
  status: 'published' | 'coming-soon';
}
const { number, title, summary, href, lessonCount, status } = Astro.props;
const published = status === 'published' && href;
const Tag2 = published ? 'a' : 'div';
---

<Tag2
  {...published ? { href } : {}}
  class:list={[
    'group flex h-full gap-4 rounded-lg border p-6 transition-colors',
    published
      ? 'border-hairline bg-canvas hover:bg-surface-soft'
      : 'border-hairline/70 bg-surface-soft/50 cursor-default',
  ]}
  aria-disabled={published ? undefined : 'true'}
>
  <span
    class:list={[
      'grid h-10 w-10 shrink-0 place-items-center rounded-full text-sm font-semibold tabular-nums',
      published ? 'bg-primary text-on-primary' : 'bg-hairline text-stone',
    ]}
    aria-hidden="true"
  >
    {String(number).padStart(2, '0')}
  </span>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class:list={['t-heading-sm', published ? 'group-hover:text-primary' : 'text-mute']}>
        {title}
      </h3>
      {status === 'coming-soon' && <Tag variant="outline">Coming soon</Tag>}
    </div>
    <p class="mt-1.5 text-[0.95rem] leading-relaxed text-mute">{summary}</p>
    {
      published && (
        <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-ink">
          {lessonCount} {lessonCount === 1 ? 'lesson' : 'lessons'}
          <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </span>
      )
    }
  </div>
</Tag2>
