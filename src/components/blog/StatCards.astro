---
/**
 * A row of small stat cards (value + label). Kept as cards, not a table.
 * Usage: <StatCards stats={[{ value: "$22M", label: "round size" }]} />
 */
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<div class="not-prose my-8 flex flex-wrap gap-3">
  {
    stats.map((s) => (
      <div class="flex-1 rounded-lg bg-surface-soft p-5" style="min-width:140px">
        <p class="text-2xl font-bold tracking-tight text-ink tabular-nums">{s.value}</p>
        <p class="mt-1 text-sm leading-snug text-mute">{s.label}</p>
      </div>
    ))
  }
</div>
